{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bizyour-i08s.onrender.com/api/:path*" },
    { "source": "/classic", "destination": "https://bizyour-i08s.onrender.com/classic/" },
    { "source": "/classic/:path*", "destination": "https://bizyour-i08s.onrender.com/classic/:path*" },
    { "source": "/hisab/:path*", "destination": "https://bizyour-i08s.onrender.com/hisab/:path*" },
    { "source": "/sw.js", "destination": "https://bizyour-i08s.onrender.com/sw.js" },
    { "source": "/((?!assets/|favicon-32.png|favicon.svg|apple-touch-icon.png|bizyour-mark-512.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
